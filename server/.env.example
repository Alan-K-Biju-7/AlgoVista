# Local server
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOCAL_DATABASE_PATH=server/data/db.json

# Session and request security. Generate independent high-entropy values in
# production; never commit the real values.
SESSION_TTL_DAYS=7
COOKIE_SAME_SITE=Lax
TRUST_PROXY=false
SESSION_DIGEST_PEPPER=replace_with_a_random_secret_in_production
CSRF_DIGEST_PEPPER=replace_with_a_different_random_secret_in_production
RATE_LIMIT_PEPPER=replace_with_another_random_secret_in_production
PASSWORD_HASH_CONCURRENCY=2
PASSWORD_HASH_QUEUE_LIMIT=32

# Production persistence. DATABASE_URL selects PostgreSQL automatically and is
# required when NODE_ENV=production.
# DATABASE_URL=postgresql://user:password@host:5432/algovista

# Personal tutor limits
AI_DAILY_REQUEST_LIMIT=150
AI_PROVIDER_CONCURRENCY=4
AI_PROVIDER_QUEUE_LIMIT=40
AI_PROVIDER_TIMEOUT_MS=15000
AI_TUTOR_OFFLINE=false

# Optional provider. With no key, the structured offline tutor remains active.
GEMINI_API_KEY=
AI_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_PROVIDER_MODEL=gemini-3.6-flash
